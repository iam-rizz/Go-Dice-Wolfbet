# wdb-go config template — copy ke wdbgo.toml.local lalu isi
# (wdbgo.toml.local sudah ada di .gitignore, jadi aman untuk secret.
# Precedence: flag > env > TOML > default.)

# --- wolfbet (default) ---
token = ""
user_hash = ""

# --- stake ---
session = ""

# --- umum ---
casino = "wolfbet"      # wolfbet | stake
currency = "trx"        # coin: free, trx, doge, dll
